            "example": "507f1f77bcf86cd799439012"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Contact creation timestamp",
            "example": "2023-10-24T10:30:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Contact last update timestamp",
            "example": "2023-10-24T15:45:00.000Z"
          }
        }
      }
    },
    "responses": null
  }

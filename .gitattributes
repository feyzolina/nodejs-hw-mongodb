# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare files that should always have LF line endings
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Declare files that will always have CRLF line endings on checkout
*.bat text eol=crlf